## ⚠ ENVELOPPES ICI, PAS DANS LA CONSTANTE. Voir l'avertissement ci-dessus.
static func all() -> Array[PackedStringArray]:
	var out: Array[PackedStringArray] = []
	for one: Array in WORLDS:
		var world: PackedStringArray = PackedStringArray()
		for row: Variant in one:
			world.append(String(row))
		out.append(world)
	return out
